# ---- database ----
DATABASE_URL="postgresql://psx:psx@localhost:5433/psx_trader?schema=public"
REDIS_URL="redis://localhost:6380"

# ---- api ----
PORT=4000
NODE_ENV=development
# openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# ---- email ----
# Verification codes are emailed, so this has to work before anyone can sign up.
#
# In development, point it at a local catcher and read the codes in its web UI.
# Mailpit on 1025 is the default here because it needs no account anywhere:
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
# then open http://localhost:8025
#
# EMAIL_TRANSPORT=console prints mail instead of sending it, for running with no
# mail server at all. It is refused in production: a verification email written
# to stdout is an account nobody can ever verify.
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PSX Trader <no-reply@psx-trader.local>"

# Where the sign-in link in emails points.
APP_URL="http://localhost:3000"

# Browsers allowed to call this API, comma separated. Native builds of the Expo
# app send no Origin header and are unaffected by this; the list is for the
# Next.js dashboard and for "expo start --web", which runs the mobile screens in
# a browser on port 8081.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ---- accounts ----
# Verification code lifetime, in minutes.
VERIFICATION_TTL_MINUTES=10
# Wrong guesses before a code is burned. Six digits is only a million
# possibilities, so this budget is what makes guessing expensive.
VERIFICATION_MAX_ATTEMPTS=5
# Stops the resend button becoming a way to mail-bomb someone.
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Per-IP budgets over 15 minutes for the credential and code endpoints.
AUTH_RATE_LIMIT=20
CODE_RATE_LIMIT=10

# ---- market data ----
# PSX Data Portal bulk-file base. Official dated files; no scraping.
PSX_DOWNLOAD_BASE="https://dps.psx.com.pk/download"
# polite delay between archive requests during backfill (ms)
PSX_BACKFILL_DELAY_MS=1200

# ---- prediction narrative (LLM writes prose over deterministic scores) ----
# Leave the key empty and the app uses the deterministic summaries, which are
# built from the same factor table the score comes from. That is a supported
# way to run, not a broken one: the prose is a rendering of the numbers, so
# losing it costs fluency and nothing else.
#
# Get a key from https://console.anthropic.com. It belongs in apps/api/.env,
# which is gitignored, not in this file.
ANTHROPIC_API_KEY=""

# claude-haiku-5-5 is about twenty times cheaper than Sonnet ($0.10/$0.50 per
# million tokens against $2/$10) and is plenty for writing five sentences over
# a table that has already been scored. Sonnet is the default only because it
# is what the cost estimate was approved against.
NARRATIVE_MODEL="claude-sonnet-5-5"

# Pinned so the Anthropic SDK cannot pick up an ANTHROPIC_BASE_URL set on the
# machine for some other tool and quietly send the prompts there instead.
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# Room for five sentences. A reply that hits the ceiling is discarded rather
# than shown half-finished.
NARRATIVE_MAX_TOKENS=1024

# A blast radius, not a budget: narratives are written for the symbols actually
# opened, a handful a day, so reaching this means something is looping. Counted
# per process, so a restart resets it.
NARRATIVE_CALL_BUDGET=250
