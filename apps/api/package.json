{
  "name": "@psx/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "nightly": "tsx src/bin/nightly.ts",
    "admin": "tsx src/bin/admin.ts",
    "backfill": "tsx src/bin/backfill.ts",
    "db:test:setup": "tsx src/bin/setup-test-db.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "reclassify": "tsx src/bin/reclassify-listings.ts",
    "narrative-eval": "tsx src/bin/narrative-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@prisma/client": "^6.1.0",
    "@psx/data": "workspace:*",
    "@psx/engine": "workspace:*",
    "@psx/ledger": "workspace:*",
    "@psx/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "nodemailer": "^6.9.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.0.4",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
