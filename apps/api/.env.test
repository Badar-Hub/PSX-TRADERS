# Test database. Separate from development on purpose: the integration suite
# truncates every table, including the shared market-data ones, so pointing it
# at the development database would destroy backfilled price history.
#
# Create it with:  pnpm --filter @psx/api db:test:setup
DATABASE_URL="postgresql://psx:psx@localhost:5433/psx_trader_test?schema=public"

NODE_ENV=test
PORT=4099

# Local-only, and distinct from the development secrets so a token from one
# environment is never valid in the other.
JWT_ACCESS_SECRET="test-access-secret-not-used-anywhere-real-0001"
JWT_REFRESH_SECRET="test-refresh-secret-not-used-anywhere-real-0002"

# Nothing is sent: the suites pass a recording mailer. This is here so a stray
# real transport can never be constructed by a test.
EMAIL_TRANSPORT=console

# The suites sign up dozens of accounts from one address. At the production
# budgets the limiter trips and later assertions fail on a 429 instead of
# testing what they claim. Raised here so the resend test's 429 comes from the
# per-account cooldown it is actually about.
AUTH_RATE_LIMIT=100000
CODE_RATE_LIMIT=100000
