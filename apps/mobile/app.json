{
  "expo": {
    "name": "PSX Trader",
    "slug": "psx-trader",
    "version": "0.1.0",
    "scheme": "psxtrader",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#020617",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tech.stellarsoft.psxtrader"
    },
    "android": {
      "package": "tech.stellarsoft.psxtrader",
      "adaptiveIcon": {
        "backgroundColor": "#020617"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "//": "Where a STANDALONE build looks for the API. Dev builds ignore this and derive the address from the Expo dev server, so it follows whatever network the laptop is on. A LAN address works only on that network with the API running; replace it with a tunnel or a deployed URL for an APK that works anywhere.",
      "apiBaseUrl": "http://10.1.0.15:4000"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
