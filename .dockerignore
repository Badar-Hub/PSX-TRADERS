# The deploy script ships a `git archive` of HEAD, so untracked files never
# reach the server in the first place. This file matters for a `docker compose
# build` run straight from a working copy — on this machine, or on the server
# after someone clones instead.

node_modules
**/node_modules

# Build output. Everything is compiled inside the image; copying a host build
# in would mix a Windows-generated Prisma client into a Linux container.
dist
**/dist
.next
**/.next
.turbo
**/.turbo

# Generated native projects, 1GB+ and irrelevant to the server.
apps/mobile/android
apps/mobile/ios
apps/mobile/dist

# Secrets. Also gitignored, listed again because a build context is not a
# commit and this is the file that governs it.
.env
**/.env
**/.env.*
!**/.env.example
apps/mobile/credentials

.git
.gitignore
README.md
**/*.md
