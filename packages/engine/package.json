    "explain": "tsx scripts/explain.ts",
    "narrative-cost": "tsx scripts/narrative-cost.ts"
  },
  "dependencies": {
    "@psx/shared": "workspace:*"
  },
  "devDependencies": {
    "@psx/data": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
