# Copy to .env.production ON THE SERVER, next to compose.prod.yml, and fill in.
#
#   cp env.production.example .env.production && chmod 600 .env.production
#
# This file is a template and is committed. The filled-in .env.production is
# not, and the deploy script never transfers it: secrets belong on the server
# and in a password manager, not in a repository or a build context. The deploy
# refuses to start if it is missing rather than falling back to defaults.
#
# apps/api/src/env.ts is the authority on what is accepted. Only the three
# values in the first block have no default; everything below is optional and
# shown with the default it falls back to.

# --- Required -------------------------------------------------------------

# Must match the Postgres credentials below. The host is the compose service
# name, so this is correct as written once the password is filled in.
DATABASE_URL=postgresql://psx:REPLACE_ME@postgres:5432/psx_trader

# Generate each one separately:  openssl rand -hex 32
# They must differ — the API refuses to start if they match, because a refresh
# token would then be accepted as an access token. Placeholder-looking values
# are rejected too, so do not leave "change-me" here.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Postgres (read by the postgres service, not the API) -----------------

POSTGRES_USER=psx
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=psx_trader

# --- Mail -----------------------------------------------------------------

# Required in practice: sign-up sends a verification code, and the API refuses
# EMAIL_TRANSPORT=console in production because a code written to stdout is an
# account nobody can verify.
# Set COMPOSE_PROFILES=mailcatcher below to run the bundled mail catcher, whose
# inbox is at http://STAGING_HOST:8025. Swap SMTP_HOST/PORT for a real server
# when mail should reach real inboxes.
COMPOSE_PROFILES=mailcatcher
EMAIL_TRANSPORT=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PSX Trader <no-reply@stellarsoft.tech>

# --- Addresses ------------------------------------------------------------

# Where the links in emails point: the dashboard's address as a browser on your
# network would type it. Replace with the staging server's own address.
APP_URL=http://STAGING_HOST:3000

# Browsers allowed to call the API. The dashboard reaches it server-side and
# needs no entry; this is for `expo start --web` and anything else in a
# browser. The phone app sends no Origin header and is unaffected.
CORS_ORIGINS=http://STAGING_HOST:3000

# --- Optional, shown with defaults ----------------------------------------

# Leave blank to run without the LLM narrative pass. That is a supported mode,
# not a degraded one: the factor table is the explanation and the app shows its
# deterministic summaries.
ANTHROPIC_API_KEY=
NARRATIVE_MODEL=claude-haiku-5-5

# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=30d
# VERIFICATION_TTL_MINUTES=10
# VERIFICATION_MAX_ATTEMPTS=5
# VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# AUTH_RATE_LIMIT=20
# CODE_RATE_LIMIT=10
# PSX_DOWNLOAD_BASE=https://dps.psx.com.pk/download
# NARRATIVE_MAX_TOKENS=1024
# NARRATIVE_CALL_BUDGET=250

# --- Host ports -----------------------------------------------------------

# Only the host side; the containers always listen on 4000 and 3000. Change
# these if something on the server already owns a default.
# API_PORT=4000
# WEB_PORT=3000
