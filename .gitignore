# Generated by `expo prebuild`. Regenerated from app.json and the config
# plugins, so committing it would mean maintaining two sources of truth for
# the native project.
apps/mobile/android/
apps/mobile/ios/

# The release signing key and its passwords. Losing this file means the app can
# never be updated in place on a device or on the Play Store, so it belongs in
# a password manager or an encrypted backup — never in the repository.
apps/mobile/credentials/
*.keystore
*.jks
